     "tasks": ["automatic-speech-recognition", "text-to-speech", "audio-classification", "zero-shot-audio-classification", "text-to-audio", "audio-to-audio", "feature-extraction"],
     "name_match": "whisper|wav2vec|xlsr|clap|speech|audio|voice"},
    {"id": "image-video", "target": 50,
