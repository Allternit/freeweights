               "time-series-forecasting", "fill-mask", "token-classification", "text2text-generation", "translation", "summarization",
               "question-answering", "text-classification", "zero-shot-classification", "feature-extraction"]},
    {"id": "families", "target": 350,
     "orgs": ["Qwen", "google", "deepseek-ai", "microsoft", "openai", "zai-org", "mistralai", "ibm-granite", "HuggingFaceTB", "openbmb", "allenai"]}
