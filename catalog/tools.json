    {
      "id": "comfyui",
      "name": "ComfyUI",
      "url": "https://github.com/comfyanonymous/ComfyUI",
      "license": "GPL-3.0",
      "what": "Node-based app for running image, video and music models. Most of the newer ones in this catalog are packaged for it.",
      "kind": "ui",
      "install": [
        "git clone https://github.com/comfyanonymous/ComfyUI",
        "cd ComfyUI && pip install -r requirements.txt",
        "python main.py"
      ],
      "use": "# put the files in ComfyUI/models/ and open the publisher's workflow",
      "platforms": [
        "Windows",
        "macOS",
        "Linux"
      ],
      "works_with": {
        "role": "runs",
        "sections": [
          "image",
          "video",
          "music"
        ],
        "tasks": [
          "text-to-image",
          "image-to-image",
          "text-to-video",
          "image-to-video",
          "text-to-audio"
        ]
      },
      "install_verified": true,
      "install_docs": "https://www.comfy.org/",
      "github": {
        "repo": "Comfy-Org/ComfyUI",
        "description": "The most powerful and modular diffusion model GUI, api and backend with a graph/nodes interface. The fastest local inference engine in the world.",
