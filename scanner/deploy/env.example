# /etc/fw-scanner/env  (root:root 0600). install.sh writes it; never commit the real one.
# The same value as the Worker secret SCANNER_SECRET (plan step 4).
SCANNER_SECRET=replace-me
# Optional: the private takedown blocklist (scripts/blocklist.py shape), root:fw-scanner 0640.
# The Worker checks blocked_hashes on every result anyway; this list holds a file before promotion too.
FREEWEIGHTS_PRIVATE_BLOCKLIST=/etc/fw-scanner/blocklist-private.json
# Optional overrides (defaults shown):
# FW_API_BASE=https://freeweights.allternit.com
# POLL_BUSY_S=30
# POLL_IDLE_S=60
# FRESHCLAM_EVERY_HOURS=12
# TOOL_TIMEOUT_S=600
